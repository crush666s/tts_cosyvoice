page {
  --bg: #f4f6f8;
  --panel: #ffffff;
  --text: #17202a;
  --muted: #68727e;
  --line: #dcdfe4;
  --teal: #0f766e;
  --teal-dark: #0b5d57;
  --teal-soft: #e6f4f2;
  --amber: #a16207;
  --amber-soft: #fef6e7;
  --red: #b42318;
  --red-soft: #feece9;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 24rpx 24rpx 220rpx;
}

.card {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.step {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--teal);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 48rpx;
  text-align: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.muted {
  color: var(--muted);
}

.pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 24rpx;
}

.pill.ready {
  background: var(--teal-soft);
  color: var(--teal-dark);
}

.note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--teal-soft);
  color: var(--teal-dark);
  font-size: 24rpx;
  line-height: 1.5;
}

.note.warn {
  background: var(--amber-soft);
  color: var(--amber);
}

.note.error {
  background: var(--red-soft);
  color: var(--red);
}

.btn {
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: var(--teal);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
}

.btn[disabled],
.btn.disabled {
  background: #b9c6c4;
  color: #ffffff;
}

.btn.ghost {
  background: #ffffff;
  color: var(--teal-dark);
  border: 1rpx solid var(--line);
}

.btn.small {
  display: inline-block;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
}
