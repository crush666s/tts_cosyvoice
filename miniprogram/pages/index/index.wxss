.topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 0 24rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1 1 auto;
  min-width: 0;
}

.brand-mark {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #0f766e, #3b82c4);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
}

.brand-text {
  min-width: 0;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.brand-sub {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.3;
}

.card-head-text {
  flex: 1 1 auto;
  min-width: 0;
}

.tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 12rpx;
  background: #eef1f3;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1 1 0;
  padding: 18rpx 0;
  border-radius: 10rpx;
  color: var(--muted);
  font-size: 27rpx;
  text-align: center;
}

.tab.active {
  background: #ffffff;
  color: var(--teal-dark);
  font-weight: 600;
}

.mic-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx 0 8rpx;
}

.mic-btn {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid var(--teal);
  background: var(--teal-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mic-btn.recording {
  border-color: var(--red);
  background: var(--red-soft);
}

.mic-dot {
  width: 56rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--teal);
}

.mic-btn.recording .mic-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--red);
}

.mic-timer {
  font-size: 46rpx;
  font-variant-numeric: tabular-nums;
}

.hint {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.preset {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.preset.active {
  border-color: var(--teal);
  background: var(--teal-soft);
}

.preset-main {
  flex: 1 1 auto;
  min-width: 0;
}

.preset-label {
  font-size: 29rpx;
  font-weight: 600;
}

.preset-desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.preset-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-btn {
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--teal-dark);
  font-size: 24rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--teal);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
}

.search {
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 27rpx;
}

.phrase-scroll {
  max-height: 620rpx;
  margin-top: 16rpx;
}

.group-name {
  padding: 18rpx 4rpx 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.phrase {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.phrase.active {
  border-color: var(--teal);
  background: var(--teal-soft);
  color: var(--teal-dark);
}

.modes {
  display: flex;
  padding: 6rpx;
  border-radius: 12rpx;
  background: #eef1f3;
}

.mode {
  flex: 1 1 0;
  padding: 20rpx 8rpx;
  border-radius: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.35;
  text-align: center;
}

.mode.active {
  background: #ffffff;
  color: var(--teal-dark);
  font-weight: 600;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  color: var(--muted);
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.picker {
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 27rpx;
  line-height: 80rpx;
}

.summary {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.summary-line {
  display: flex;
  gap: 16rpx;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.summary-key {
  flex: 0 0 130rpx;
  color: var(--muted);
}

.summary-val {
  flex: 1 1 auto;
  min-width: 0;
}

.result {
  margin-top: 28rpx;
}

.result-head {
  font-size: 29rpx;
  font-weight: 600;
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.script-input {
  width: 100%;
  min-height: 108rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d6dde4;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1f2933;
}

.select-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--teal);
  color: #ffffff;
  font-size: 24rpx;
}

.preset.active .select-btn {
  background: var(--teal-dark);
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 12rpx 16rpx 22rpx;
  background: #ffffff;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -6rpx 24rpx rgba(23, 32, 42, 0.06);
}

.tabbar-item {
  flex: 1 1 0;
  width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  color: var(--muted);
}

.tabbar-item.active {
  color: var(--teal-dark);
}

.tabbar-idx {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: #f5f7f8;
  font-size: 26rpx;
  line-height: 46rpx;
  text-align: center;
}

.tabbar-item.active .tabbar-idx {
  border-color: var(--teal);
  background: var(--teal);
  color: #ffffff;
}

.tabbar-text {
  margin-top: 6rpx;
  font-size: 22rpx;
}
